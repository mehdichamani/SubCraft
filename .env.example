# Telegram Bot configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# AI Service API Keys
# GROQ_API_KEY is required and handles both Speech-to-Text (Whisper) & Persian Subtitle Translation
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_TRANSLATE_MODEL=openai/gpt-oss-120b
# Optional Gemini API Key(s) for fallback translation - Supports single key or comma-separated keys:
# GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
# GEMINI_API_KEYS=AIzaSy_key1,AIzaSy_key2,AIzaSy_key3
OPENAI_API_KEY=sk-your_openai_api_key_here

# Render / Public Deployment URL (No trailing slash)
# Example: https://subcraft.onrender.com
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com

# Optional Webhook Secret Token (Security best practice)
WEBHOOK_SECRET=your_random_secret_token_here

# Cookies for yt-dlp authentication (YouTube, Instagram, etc.):
# 1. On Render.com or Cloud Envs: Convert cookies.txt to Base64 (e.g. `base64 -w 0 cookies.txt`) and paste here as a single line string.
# 2. On Local/VPS: Can be plain Netscape cookies text, file path (`cookies.txt`), or Base64 string.
YOUTUBE_COOKIES=
INSTAGRAM_COOKIES=
COOKIES=

# Server Port (Defaults to 8000 if not set by host)
PORT=8000

# PostgreSQL Database URL for Dashboard Persistence
# On Render: Use the Internal Database URL from your Render Postgres service inside the same project
# Example: postgresql://user:password@dpg-xxxx-a.oregon-postgres.render.com/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/clip_srt_db
